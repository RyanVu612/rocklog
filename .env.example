# -----------------------------------------------------------------------------
# Rocklog environment variables — copy this file to `.env` and fill in real values.
# NEVER commit your real `.env`. Only this `.env.example` belongs in git.
# -----------------------------------------------------------------------------

# Prisma / Supabase Postgres -------------------------------------------------
# Pooled connection string (used at runtime by the app). From Supabase:
#   Project Settings -> Database -> Connection string -> "Transaction" pooler.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection string (used by Prisma Migrate). "Session" pooler / direct 5432.
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# NextAuth -------------------------------------------------------------------
# Generate a secret with: `npx auth secret` or `openssl rand -base64 32`
NEXTAUTH_SECRET=""
# The canonical URL of your site. Local dev: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# OAuth providers (configure at least ONE) ------------------------------------
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Supabase Storage (media: photos/videos) ------------------------------------
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
# Anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service role key — SERVER ONLY. Never expose to the client. Used to delete
# media and to upload from server-side tRPC procedures.
SUPABASE_SERVICE_ROLE_KEY=""
# Name of the Storage bucket that holds climb media.
SUPABASE_MEDIA_BUCKET="climb-media"
